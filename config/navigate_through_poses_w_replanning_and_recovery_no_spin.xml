<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="0.666" name="RateController">
        <RecoveryNode number_of_retries="2" name="ComputePath">
          <ReactiveSequence name="PruneAndComputePathThroughPoses">
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="1.2"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </ReactiveSequence>
          <ClearEntireCostmap
            name="ClearGlobalCostmap-Context"
            service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>
      </RateController>
      <SmoothPath
        unsmoothed_path="{path}"
        smoothed_path="{smoothed_path}"
        smoother_id="Constrained"
        max_smoothing_duration="0.35"
        check_for_collisions="true"/>
      <RecoveryNode number_of_retries="2" name="FollowPath">
        <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
        <Sequence name="FollowPathRecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap
              name="ClearLocalCostmap-Subtree"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Subtree"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="2.0" backup_speed="1.2"/>
        </Sequence>
      </RecoveryNode>
    </PipelineSequence>
  </BehaviorTree>
</root>
